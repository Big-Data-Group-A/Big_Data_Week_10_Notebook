  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 1 · Explore & split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [

     ]
    }
   ],
   "source": [
    "print(\"Shape:\", df.shape)\n",
    "for feature in [\"quiz_avg\", \"assignments_avg\", \"attendance_pct\"]:\n",
    "    print(f\"score vs {feature}: {df[feature].corr(df['score']):.3f}\")\n",
    "# Quiz average has the strongest linear relationship with score in this dataset.\n",
    "\n",
    "X = df[[\"quiz_avg\", \"assignments_avg\", \"attendance_pct\"]]\n",
    "y = df[\"score\"]\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.25, random_state=42\n",
    ")\n",
    "print(\"Train:\", len(X_train), \"Test:\", len(X_test))\n",
    "# Holding out 25% gives an unseen group to estimate how well the model generalizes."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 2 · Regression — predict the score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "quiz_avg: 0.579\n",
      "assignments_avg: 0.365\n",
      "attendance_pct: 0.113\n",
      "intercept: -4.428\n",
      "MAE: 3.329\n",
      "R2: 0.887\n",
      "New student predicted score: 73.66\n",
      "Illustrative invented profile: 71.27"
     ]
    }
   ],
   "source": [
    "model = LinearRegression().fit(X_train, y_train)\n",
    "for feature, value in zip(X.columns, model.coef_):\n",
    "    print(f\"{feature}: {value:.3f}\")\n",
    "print(\"intercept:\", round(model.intercept_, 3))\n",
    "# The quiz coefficient estimates the exam-score change associated with one more quiz point, holding the other features fixed.\n",
    "\n",
    "y_pred = model.predict(X_test)\n",
    "print(\"MAE:\", mean_absolute_error(y_test, y_pred))\n",
    "print(\"R2:\", r2_score(y_test, y_pred))\n",
    "# MAE is the typical absolute prediction error in score points. R2 is the share of test-score variation explained by this model.\n",
    "\n",
    "new_student = pd.DataFrame({\"quiz_avg\": [70], \"assignments_avg\": [75], \"attendance_pct\": [90]})\n",
    "print(\"New student predicted score:\", model.predict(new_student)[0])\n",
    "my_student = pd.DataFrame({\"quiz_avg\": [70], \"assignments_avg\": [70], \"attendance_pct\": [85]})\n",
    "print(\"Illustrative invented profile:\", model.predict(my_student)[0])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 3 · Classification — at-risk students"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Pass    131\n",
      "Fail    19\n",
      "Model accuracy: 0.895\n",
      "Always-pass baseline: 0.895\n",
      "Confusion matrix (actual rows: fail, pass; predicted columns: fail, pass):\n",
      "[[3 1]\n",
      " [3 31]]"
     ]
    }
   ],
   "source": [
    "df[\"passed\"] = (df[\"score\"] >= 50).astype(int)\n",
    "print(df[\"passed\"].value_counts().rename(index={1: \"Pass\", 0: \"Fail\"}))\n",
    "Xc_train, Xc_test, yc_train, yc_test = train_test_split(\n",
    "    X, df[\"passed\"], test_size=0.25, random_state=42\n",
    ")\n",
    "classifier = LogisticRegression(max_iter=1000).fit(Xc_train, yc_train)\n",
    "yc_pred = classifier.predict(Xc_test)\n",
    "print(\"Model accuracy:\", accuracy_score(yc_test, yc_pred))\n",
    "print(\"Always-pass baseline:\", yc_test.mean())\n",
    "print(\"Confusion matrix (actual rows: fail, pass; predicted columns: fail, pass):\")\n",
    "print(confusion_matrix(yc_test, yc_pred, labels=[0, 1]))\n",

   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 4 · Feature engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Quiz only: 0.624\n",
      "All numeric: 0.887\n",
      "Numeric + program: 0.880"
     ]
    }
   ],
   "source": [
    "def test_r2(features):\n",
    "    Xtr, Xte, ytr, yte = train_test_split(features, y, test_size=0.25, random_state=42)\n",
    "    fitted = LinearRegression().fit(Xtr, ytr)\n",
    "    return r2_score(yte, fitted.predict(Xte))\n",
    "\n",
    "quiz_only = df[[\"quiz_avg\"]]\n",
    "all_numeric = df[[\"quiz_avg\", \"assignments_avg\", \"attendance_pct\"]]\n",
    "with_program = pd.concat([all_numeric, pd.get_dummies(df[\"program\"], prefix=\"program\", drop_first=True)], axis=1)\n",
    "print(\"Quiz only:\", test_r2(quiz_only))\n",
    "print(\"All numeric:\", test_r2(all_numeric))\n",
    "print(\"Numeric + program:\", test_r2(with_program))\n",
    
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 5 · Ship a dashboard"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"passed\"] = (df[\"score\"] >= 50).astype(int)\n",
    "fig1 = px.histogram(df, x=\"score\", nbins=12, title=\"1. Where the class stands\")\n",
    "fig2 = px.scatter(df, x=\"quiz_avg\", y=\"score\", color=\"passed\", hover_name=\"name\",\n",
    "                  title=\"2. Who is at risk\")\n",
    "fig3 = px.bar(df.groupby(\"district\", as_index=False)[\"score\"].mean(),\n",
    "              x=\"district\", y=\"score\", title=\"3. Where to act\")\n",
    "fig1.show(); fig2.show(); fig3.show()\n",
    "fig2.write_html(\"class_dashboard.html\")"
   ]
  },
  {
   "cell_type": "markdown",
